{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/.aws/credentials)",
      "Read(**/.git-credentials)",
      "Read(**/.npmrc)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.git/**)",
      "Write(.git/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(:* | bash)",
      "Bash(:* | sh)"
    ],
    "ask": [
      "Bash(git push:*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/zt-guard.sh" }]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/zt-file-guard.sh" }]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/zt-secret-scan.sh" }]
      },
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/zt-log.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "bash .claude/hooks/zt-log.sh" }]
      }
    ]
  }
}
